{
  "schema_version": 1,
  "framework_version": "0.3.0",
  "default_profile": "standard",
  "security_evidence": {
    "max_age_days": 7,
    "allow_risk_exceptions": false,
    "required_tools": ["bandit", "detect-secrets", "pip-audit"]
  },
  "change_classes": {
    "trivial": {
      "description": "Documentation, comments, formatting, or an isolated low-risk correction.",
      "requires_change": false,
      "requires_adr": false,
      "requires_human_review": false,
      "requires_security_review": false
    },
    "standard": {
      "description": "A normal feature, behaviour, configuration, or dependency change.",
      "requires_change": true,
      "requires_adr": false,
      "requires_human_review": false,
      "requires_security_review": true
    },
    "high-risk": {
      "description": "Authentication, authorization, secrets, sensitive data, migrations, architecture, production infrastructure, or AI safety.",
      "requires_change": true,
      "requires_adr": true,
      "requires_human_review": true,
      "requires_security_review": true
    }
  },
  "profiles": {
    "lite": {
      "description": "Lightweight evidence for solo and exploratory projects.",
      "completion_review_for": ["high-risk"],
      "review_signoff": "agent_recommendation",
      "require_committed_evidence": false
    },
    "standard": {
      "description": "Recommended approval and completion gates.",
      "completion_review_for": ["standard", "high-risk"],
      "review_signoff": "human_change_transition",
      "require_committed_evidence": false
    },
    "regulated": {
      "description": "Full evidence and review for audit-sensitive work.",
      "completion_review_for": ["trivial", "standard", "high-risk"],
      "review_signoff": "human_review",
      "require_committed_evidence": true
    }
  },
  "human_only": {
    "change": ["approval.status", "approval.approved_by", "approval.date"],
    "adr": ["status.current_status", "approval.approved_by", "approval.date"],
    "requirement": ["approval.status", "approval.approved_by", "approval.date"],
    "review": ["summary_verdict", "approval.reviewer", "approval.date", "approval.approved_source_digest"],
    "retrospective": ["sign_off.status", "sign_off.reviewed_by", "sign_off.date"]
  },
  "security_baselines": {
    "S0": "All software",
    "A0": "AI or LLM features",
    "V0": "Audit or compliance evidence",
    "C0": "Cloud deployment"
  },
  "token_budgets": {
    "always_on_adapter": 800,
    "resume_context": 2000,
    "implementation_context": 4000
  },
  "artifact_context_budgets": {
    "requirement": {"target": 1500, "warning": 3000, "enforcement": "informational"},
    "adr": {"target": 700, "warning": 1500, "enforcement": "informational"},
    "change": {"target": 1200, "warning": 2500, "enforcement": "regulated"},
    "review": {"target": 1200, "warning": 2500, "enforcement": "regulated"},
    "test_summary": {"target": 800, "warning": 1500, "enforcement": "regulated"},
    "state": {"target": 500, "warning": 1000, "enforcement": "regulated"}
  },
  "strict_warning_codes": [
    "METADATA_COMPATIBILITY_MODE",
    "NON_ISO_APPROVAL_DATE",
    "STATUS_CONFLICT",
    "STATE_CONTEXT_OVERSIZE",
    "ARTIFACT_CONTEXT_OVERSIZE"
  ],
  "rules": {
    "R1": "Read STATE.md and context.md before significant or resumed work.",
    "R2": "Classify the requested change before deciding which gates apply.",
    "R3": "Standard and high-risk implementation requires a human-approved change proposal.",
    "R4": "High-risk implementation requires accepted blocking ADRs.",
    "R5": "When multiple changes are approved, STATE.md must name one Active Change.",
    "R6": "Assistants never modify human-only approval fields.",
    "R7": "Required reviews need fresh scan evidence. Human sign-off binds the source digest; completion follows profile/class policy.",
    "R8": "Detailed role, workflow, and security references are loaded only when applicable."
  }
}
